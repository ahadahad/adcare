# Keep these values server-only. Never prefix secret keys with VITE_.
# Optional A4 Gemini corner detection
GEMINI_API_KEY=

# Optional Photo Studio AI and background-removal providers
TOKEN_HARBOR_API_KEY=
TOKEN_HARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKEN_HARBOR_MODEL=gpt-5.6-luna
REMOVE_BG_API_KEY=
REAL_ESRGAN_ENABLED=true
REAL_ESRGAN_MODEL=realesr-general-x4v3

# Optional service origins when hosting the two original API servers separately
A4_API_ORIGIN=http://127.0.0.1:3001
PHOTO_API_ORIGIN=http://127.0.0.1:3002
