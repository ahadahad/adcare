{
  "name": "ahad-digital-care",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n shell,a4-api,photo-api -c cyan,green,magenta \"vite --host 0.0.0.0 --port 3000\" \"npm:dev:a4-api\" \"npm:dev:photo-api\"",
    "dev:a4-api": "cd legacy/a4-print && cross-env PORT=3001 ../../node_modules/.bin/tsx server.ts",
    "dev:photo-api": "cd legacy/photo-studio && cross-env PORT=3002 ../../node_modules/.bin/tsx server.ts",
    "build": "vite build && node scripts/prepare-assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:a4-crop-learning": "cd legacy/a4-print && ../../node_modules/.bin/tsx -e \"import { runCropLearningTests } from './src/services/cropLearning/cropLearning.test'; runCropLearningTests().then(res => { console.log('Passed:', res.passed, 'Failed:', res.failed); if (res.failed > 0) process.exit(1); });\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.6.2",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
